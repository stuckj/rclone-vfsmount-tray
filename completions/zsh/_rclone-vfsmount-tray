#compdef rclone-vfsmount-tray

autoload -U is-at-least

_rclone-vfsmount-tray() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--log-level=[Log verbosity. Takes precedence over \`RUST_LOG\`; defaults to \`info\`]:LEVEL:_default' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_rclone-vfsmount-tray_commands" \
"*::: :->rclone-vfsmount-tray" \
&& ret=0
    case $state in
    (rclone-vfsmount-tray)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rclone-vfsmount-tray-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(mount)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(unmount)
_arguments "${_arguments_options[@]}" : \
'--force[Unmount even while the mount is in use. A file being written is severed mid-write, and rclone later uploads the partial file as though complete]' \
'-h[Print help]' \
'--help[Print help]' \
':name:_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Emit JSON. This is the stable surface for scripting and tests]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rclone-vfsmount-tray__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rclone-vfsmount-tray-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mount)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unmount)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rclone-vfsmount-tray_commands] )) ||
_rclone-vfsmount-tray_commands() {
    local commands; commands=(
'list:List configured mounts and their state' \
'mount:Mount one configured mount' \
'unmount:Unmount one mount. Refused while anything is still using it unless \`--force\`' \
'status:Print mount and transfer state' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rclone-vfsmount-tray commands' commands "$@"
}
(( $+functions[_rclone-vfsmount-tray__subcmd__help_commands] )) ||
_rclone-vfsmount-tray__subcmd__help_commands() {
