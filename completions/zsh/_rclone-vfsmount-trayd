#compdef rclone-vfsmount-trayd

autoload -U is-at-least

_rclone-vfsmount-trayd() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Path to the configuration file. Defaults to \`\$XDG_CONFIG_HOME/rclone-vfsmount-tray/config.toml\`]:PATH:_files' \
'--log-level=[Log verbosity. Takes precedence over \`RUST_LOG\`; defaults to \`info\`]:LEVEL:_default' \
'--foreground[Accepted and ignored. It will mean "stay in the foreground and log to stderr" once there is a background mode to opt out of; today that is all the service does]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_rclone-vfsmount-trayd_commands" \
"*::: :->rclone-vfsmount-trayd" \
&& ret=0
    case $state in
    (rclone-vfsmount-trayd)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rclone-vfsmount-trayd-command-$line[1]:"
        case $line[1] in
            (prepare-mount)
_arguments "${_arguments_options[@]}" : \
'--name=[]:NAME:_default' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rclone-vfsmount-trayd__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rclone-vfsmount-trayd-help-command-$line[1]:"
        case $line[1] in
            (prepare-mount)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rclone-vfsmount-trayd_commands] )) ||
_rclone-vfsmount-trayd_commands() {
    local commands; commands=(
'prepare-mount:Clear what a hard-killed rclone left behind, so its unit can start' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rclone-vfsmount-trayd commands' commands "$@"
}
(( $+functions[_rclone-vfsmount-trayd__subcmd__help_commands] )) ||
_rclone-vfsmount-trayd__subcmd__help_commands() {
    local commands; commands=(
'prepare-mount:Clear what a hard-killed rclone left behind, so its unit can start' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rclone-vfsmount-trayd help commands' commands "$@"
}
(( $+functions[_rclone-vfsmount-trayd__subcmd__help__subcmd__help_commands] )) ||
_rclone-vfsmount-trayd__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'rclone-vfsmount-trayd help help commands' commands "$@"
}
(( $+functions[_rclone-vfsmount-trayd__subcmd__help__subcmd__prepare-mount_commands] )) ||
_rclone-vfsmount-trayd__subcmd__help__subcmd__prepare-mount_commands() {
    local commands; commands=()
    _describe -t commands 'rclone-vfsmount-trayd help prepare-mount commands' commands "$@"
}
(( $+functions[_rclone-vfsmount-trayd__subcmd__prepare-mount_commands] )) ||
_rclone-vfsmount-trayd__subcmd__prepare-mount_commands() {
    local commands; commands=()
    _describe -t commands 'rclone-vfsmount-trayd prepare-mount commands' commands "$@"
}

if [ "$funcstack[1]" = "_rclone-vfsmount-trayd" ]; then
    _rclone-vfsmount-trayd "$@"
else
    compdef _rclone-vfsmount-trayd rclone-vfsmount-trayd
fi
